# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL (PostgreSQL) runtime & migration environment variables (injected automatically by AI Studio)
SQL_HOST="/cloudsql/instance"
SQL_DB_NAME="postgres"
SQL_USER="app_user"
SQL_PASSWORD="app_password"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="admin_password"

# Split Deployment Variables (Vercel Frontend + Dedicated Fly.io / Render Backend)
VITE_API_BASE_URL=""
VITE_WS_SERVER_URL=""
DATABASE_URL=""
CORS_ORIGIN="*"

